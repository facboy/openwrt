### my config, from asking Gemini about my `imagebuilder` config

# CONFIG_PACKAGE_nftables is not set
# CONFIG_PACKAGE_uclient-fetch is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# Things that should be included but for some reason are 'm' if left to defaults
CONFIG_PACKAGE_ipq-wifi-netgear_rbk750=y

# System Utilities & CLI Tools
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_tcpdump=y

# Networking & Cryptography
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_vxlan=y
CONFIG_PACKAGE_mesh11sd=y
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_libmbedtls=y

# Kernel Modules & Lua/ucode bindings
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_ucode-mod-uloop=y

# LuCI Web Interface & Apps
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-openwrt-2020=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-dawn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-uhttpd=y
